<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    android:id="@+id/mainRoot"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101827"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="12dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DAILY BRAIN"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/puzzleNumberText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DAILY PUZZLE #01"
        android:textColor="#93C5FD"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="2dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connect all the cells. Follow the checkpoints!"
        android:textColor="#CBD5E1"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp" />

    <!-- Timer and progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="#1E293B"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIME"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/timerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="34dp"
            android:background="#475569" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CELLS"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cellCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 25"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Game board -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F5F7FA"
        android:padding="0dp">

        <com.mssf.dailybrain.GameView
            android:id="@+id/gameView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- Result message -->


    <LinearLayout
        android:id="@+id/completionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#101827"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆"
            android:textSize="36sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/completionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STAGE COMPLETE!"
            android:textColor="#4CC846"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/completionTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Great job! Ready for the next challenge?"
            android:textColor="#AAB4C5"
            android:textSize="14sp"
            android:gravity="center" />

        <Button
            android:id="@+id/nextStageButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="NEXT STAGE  →"
            android:textColor="#102018"
            android:textStyle="bold"
            android:backgroundTint="#4CC846" />

        <Button
            android:id="@+id/replayButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="↻  REPLAY"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#334155" />


    </LinearLayout>



    <!-- Reset button -->
    <!-- Game controls -->
    <LinearLayout
        android:id="@+id/gameControls"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/hintButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="HINT"
            android:textColor="#263238"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="@drawable/bg_hint_button"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:padding="0dp" />

        <Space
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/undoButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="UNDO"
            android:textColor="#263238"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="@drawable/bg_undo_button"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:padding="0dp" />


    </LinearLayout>

    <!-- How to Play -->
    <LinearLayout
        android:id="@+id/howToPlaySection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:background="#1E293B"
        android:padding="10dp">

        <TextView
            android:id="@+id/howToPlayHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HOW TO PLAY                         ▼"
            android:textColor="#4CC846"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="4dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true" />


        <LinearLayout
            android:id="@+id/howToPlayContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:paddingTop="12dp">

            <!-- Connect checkpoints -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <FrameLayout
                    android:layout_width="110dp"
                    android:layout_height="65dp">

                    <View
                        android:layout_width="65dp"
                        android:layout_height="4dp"
                        android:layout_gravity="center"
                        android:background="#2563EB" />

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center_vertical|start"
                        android:background="@drawable/bg_howto_dot"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_howto_dot"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center_vertical|end"
                        android:background="@drawable/bg_howto_dot"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Connect the checkpoints in order"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Fill every cell -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:src="@drawable/how_to_fill_cells"
                    android:scaleType="fitCenter"
                    android:contentDescription="A grid filled with a blue path" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fill every cell"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>


    </LinearLayout>

</LinearLayout>
